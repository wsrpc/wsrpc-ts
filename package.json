{
  "name": "@wsrpc/server",
  "version": "0.1.0",
  "description": "Bidirectional WebSocket RPC for Node.js and TypeScript",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Dmitry Orlov <orlovdl@gmail.com>",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "test": "tsc -p tsconfig.test.json && node --test --test-timeout=15000 build/tests/*.test.js",
    "test:interop": "tsc -p tsconfig.test.json && uv run --locked --project tests/interop python tests/interop.py",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ws": "^8.22.0",
    "@types/ws": "^8.18.1",
    "@types/node": "^22.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "express": "^5.0.0",
    "fastify": "^5.0.0",
    "typescript": "^7.0.2",
    "prettier": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsrpc/wsrpc-ts.git"
  },
  "homepage": "https://docs.wsrpc.org/typescript/",
  "bugs": {
    "url": "https://github.com/wsrpc/wsrpc-ts/issues"
  }
}
