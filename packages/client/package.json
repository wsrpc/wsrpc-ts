{
  "author": "Dmitry Orlov <orlovdl@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsrpc/wsrpc-ts.git",
    "directory": "packages/client"
  },
  "homepage": "https://docs.wsrpc.org/typescript/",
  "bugs": {
    "url": "https://github.com/wsrpc/wsrpc-ts/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "name": "@wsrpc/client",
  "version": "4.5.0",
  "description": "Bidirectional WebSocket RPC client for browsers and Node.js",
  "license": "MIT",
  "main": "dist/wsrpc.min.js",
  "module": "wsrpc.es6.js",
  "types": "lib/index.d.ts",
  "files": [
    "dist",
    "lib",
    "src",
    "wsrpc.es6.js",
    "wsrpc.d.ts",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./lib/browser.d.cts",
        "default": "./dist/wsrpc.min.js"
      }
    },
    "./node": {
      "types": "./lib/node.d.ts",
      "import": "./lib/node.js"
    },
    "./core": {
      "types": "./lib/core.d.ts",
      "import": "./lib/core.js"
    },
    "./wsrpc.es6.js": {
      "types": "./lib/browser.d.ts",
      "import": "./lib/browser.js",
      "default": "./wsrpc.es6.js"
    },
    "./wsrpc.d.ts": "./wsrpc.d.ts",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "@types/node": "^22.0.0"
  },
  "peerDependencies": {
    "ws": "^8.22.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  }
}
